# Copy to .env for local development. On Render, set these in the dashboard instead.

# Database (defaults to a local SQLite file)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to false after creating your own account to stop new sign-ups
ALLOW_REGISTRATION=true

# Background pinger: called every 10 minutes when set; leave empty to disable.
# Example (keeps a Render free instance awake): https://your-app.onrender.com/api/health
PING_URL=

# Optional: override the 10 minute interval (seconds). Mainly for testing.
# PING_INTERVAL_SECONDS=600
